# Copy to .env and fill in. Never commit .env.

# --- Access (required) ---
# npm run hash-password -- "a long passphrase you don't use elsewhere"
APP_PASSWORD_HASH=
# npm run new-totp   (strongly recommended; REQUIRED for live mode)
TOTP_SECRET=
HOST=127.0.0.1
PORT=8787
# Only needed to bind beyond localhost. Without both, a non-loopback HOST is refused.
TLS_CERT=
TLS_KEY=

# --- Broker: Alpaca (stocks + crypto). Free paper account: https://app.alpaca.markets/signup ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# paper (default) | live. Live also needs LIVE_TRADING_ACK=I_ACCEPT_REAL_MONEY_RISK and live API keys.
TRADING_MODE=paper
LIVE_TRADING_ACK=

# --- Risk limits (enforced server-side on every order) ---
MAX_ORDER_USD=1000
MAX_ORDERS_PER_DAY=20
MAX_POSITION_PCT=10
MAX_LIMIT_DEVIATION_PCT=10
# total $ traded per UTC day
MAX_DAILY_NOTIONAL_USD=10000
# market orders are refused when the last trade is older than this (thin/after-hours tickers)
MAX_PRICE_AGE_SEC=900
# with a stop-loss, (entry - stop) x qty may not exceed this % of equity
MAX_RISK_PER_TRADE_PCT=2
# on = every buy must carry a stop-loss (bracket), so the per-trade risk cap always applies
REQUIRE_STOP=off
# on = start with trading halted
KILL_SWITCH=off

# --- AI: Claude (https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Research sources the AI reads and learns from (Research tab, Autopilot learning tasks) ---
# Finviz Elite (screener export API): https://elite.finviz.com -> Settings -> API. Free Finviz has no API.
FINVIZ_AUTH_TOKEN=
# Messari API key: https://messari.io/api
MESSARI_API_KEY=
# Invo traders need no key: their positions are public on Hyperliquid (paste the trader's 0x address).
# SEC EDGAR (official filings + financials, free): the SEC requires a contact in every request: your name or email.
SEC_CONTACT=
# FRED macro data (rates, CPI, unemployment, VIX), free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# No key needed: DefiLlama (DeFi TVL), Crypto Fear & Greed (alternative.me), GDELT (global news), WhatToMine.

# --- Autopilot (scheduled tracking, day trading, recurring buys, AI learning) ---
# Tasks may place orders on a PAPER account freely (through every risk limit). On a LIVE account they need this:
AUTOPILOT_LIVE_ACK=

# --- Webhooks ---
# npm run new-secret  (min 16 chars). Inbound endpoint: POST /webhooks/tradingview
WEBHOOK_SECRET=
# on = webhook alerts place orders (through the same risk gate). off = alert + notify only.
WEBHOOK_TRADING=off
# Allow webhook orders in live mode: I_ACCEPT_REAL_MONEY_RISK
WEBHOOK_LIVE_ACK=
# Outbound alerts (Discord or Slack incoming webhook URL)
NOTIFY_WEBHOOK_URL=

# Extra hostnames the UI may be reached by (e.g. a tunnel hostname). DNS-rebinding guard.
ALLOWED_HOSTS=

# --- Mining fleet (remote rigs) ---
# npm run make-cert, paste the FLEET_TLS_* lines, set FLEET_ENABLED=on, restart.
FLEET_ENABLED=off
FLEET_TLS_CERT=
FLEET_TLS_KEY=
# Rig listener (only /rig/pair and /rig/heartbeat; TLS only)
FLEET_HOST=0.0.0.0
FLEET_PORT=8788
# Address rigs use to reach this host; defaults to https://<LAN IP>:FLEET_PORT
FLEET_PUBLIC_URL=

# --- Crypto data ---
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Banks & outside brokerages (Plaid: https://dashboard.plaid.com/signup) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test logins user_good / pass_good) | production
PLAID_ENV=sandbox
# required with Plaid or Schwab: encrypts bank/broker access tokens at rest (npm run new-secret)
BANK_ENCRYPTION_KEY=

# --- Charles Schwab (https://developer.schwab.com: app with "Accounts and Trading Production" + "Market Data Production") ---
# Callback URL registered on the app (default https://127.0.0.1). Connect in the Banks tab; Schwab requires re-connecting every 7 days.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# SCHWAB_REDIRECT_URI=https://127.0.0.1
# on = trade Schwab accounts from the order ticket. Always REAL MONEY; requires TOTP_SECRET. Default: read-only.
SCHWAB_TRADING=off
